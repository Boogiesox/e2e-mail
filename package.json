{
  "name": "e2e-mail",
  "version": "0.0.7",
  "description": "A zero-config solution for testing email in major testing frameworks.",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./cypress": {
      "types": "./dist/cypress/cypress.d.ts",
      "import": "./dist/cypress.js"
    },
    "./playwright": {
      "types": "./dist/playwright/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "src/cypress/README.md",
    "src/playwright/README.md"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "schema": "tsx scripts/generate-types.ts application/json https://api.mail.tm/docs.jsonopenapi ./src/core/api/mailtm-api.d.ts",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "e2e:cypress": "cypress open",
    "e2e:playwright": "playwright test --ui"
  },
  "keywords": [
    "Cypress",
    "Playwright",
    "Testing",
    "Email"
  ],
  "author": "Eric Gregoire",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.9.2",
    "cypress": "^15.17.0",
    "e2e-mail": "^0.0.7",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^5.0.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "cypress": "^15",
    "playwright": "^1.60"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
